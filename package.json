{
  "name": "retrostage-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "format:check": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"dependency-cruiser.config.cjs\" \"knip.json\" \"tsconfig.json\" \".github/**/*.yml\" \"tooling/**/*.{ts,mjs}\" \"packages/*/package.json\" \"apps/editor-electron/**/*.{json,ts,mjs,html,css}\"",
    "lint": "eslint \"tooling/**/*.{ts,mjs}\" \"apps/editor-electron/**/*.{ts,mjs}\" \"eslint.config.mjs\" \"prettier.config.mjs\"",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project apps/editor-electron/tsconfig.json --noEmit",
    "test": "vitest run --exclude \"apps/editor-electron/out/**\"",
    "arch:check": "node --experimental-loader ./tooling/node-fs-r-ok-compat-loader.mjs ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config dependency-cruiser.config.cjs tooling apps/editor-electron/src",
    "deadcode:check": "knip",
    "build:tooling": "tsc --project tsconfig.json --noEmit false --outDir dist/tooling",
    "electron:acquire": "node apps/editor-electron/node_modules/electron/install.js",
    "electron:build": "pnpm --dir apps/editor-electron run build",
    "electron:package": "pnpm --dir apps/editor-electron run package",
    "electron:smoke": "pnpm --dir apps/editor-electron run smoke",
    "build": "pnpm run build:tooling && pnpm run electron:build",
    "workflow:check": "node tooling/workflow-policy.mjs",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run arch:check && pnpm run deadcode:check && pnpm run electron:acquire && pnpm run build && pnpm run workflow:check && pnpm run electron:package && pnpm run electron:smoke && pnpm run compliance:check && pnpm run dependency:audit",
    "dependency:audit": "pnpm audit --audit-level low",
    "compliance:generate": "node tooling/compliance/generate.mjs compliance",
    "compliance:check": "node tooling/compliance/check.mjs",
    "ci:validate": "pnpm install --frozen-lockfile && pnpm run validate && pnpm run compliance:check && pnpm run dependency:audit"
  },
  "devDependencies": {
    "dependency-cruiser": "16.10.0",
    "eslint": "9.21.0",
    "knip": "6.32.0",
    "prettier": "3.5.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "3.2.6"
  }
}
