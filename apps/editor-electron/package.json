{
  "name": "@retrostage/editor-electron",
  "productName": "RetroStage Maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": ".vite/main/main.cjs",
  "config": {
    "forge": "./forge.config.mjs"
  },
  "scripts": {
    "build:main": "vite build --config vite.main.config.mjs",
    "build:preload": "vite build --config vite.preload.config.mjs",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "dev": "pnpm run build && electron .",
    "package": "node scripts/forge.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@retrostage/renderer-babylon9": "workspace:*"
  },
  "devDependencies": {
    "@electron-forge/core": "7.11.2",
    "electron": "43.4.0",
    "vite": "8.2.1"
  }
}
