{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignore": ["dependency-cruiser.config.cjs"]
    },
    "packages/*": {},
    "apps/editor-electron": {
      "ignoreBinaries": ["ps", "tasklist.exe"],
      "entry": [
        "src/main/main.ts",
        "src/preload/preload.ts",
        "src/renderer/renderer.ts",
        "scripts/*.mjs",
        "test/*.test.mjs",
        "vite.*.config.mjs",
        "forge.config.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs", "test/*.test.mjs", "*.config.mjs"]
    }
  }
}
